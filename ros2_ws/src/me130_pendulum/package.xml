  <version>1.0.0</version>
  <description>ME130 inverted pendulum: sensing, motor driver, controller and the four lab procedures.</description>
  <maintainer email="rkcosner@gmail.com">ME130</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_srvs</depend>
